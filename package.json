{
  "name": "downpipe-backend",
  "version": "0.1.0",
  "description": "Backend REST API do Downpipe - rede social para entusiastas de carros",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "migrate": "tsx src/database/run-migrations.ts",
    "seed": "tsx src/database/seeds/run-seed.ts",
    "sync:fipe": "tsx src/modules/vehicle-sync/sync.runner.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@types/qrcode": "^1.5.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/web-push": "^3.6.4",
    "pg": "^8.12.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
