# ==========================================
# Supabase
# ==========================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Banco de dados (usado pelo runner de migrations/seeds)
# ==========================================
DATABASE_URL=

# ==========================================
# FIPE
# ==========================================
FIPE_API_URL=https://parallelum.com.br/fipe/api/v1

# ==========================================
# App
# ==========================================
PORT=3000
NODE_ENV=development

# Origem(ns) permitida(s) para CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:19006

# ==========================================
# Web Push (notificações push do PWA)
# ==========================================
# Gerar um par novo: node -e "console.log(require('web-push').generateVAPIDKeys())"
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:downpipeapp@gmail.com
